{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "scheme": "lifeos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFBFA",
    "ios": {
      "bundleIdentifier": "cz.humancare.prototype",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cz.humancare.prototype",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#D4F81B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#D4F81B"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "LifeOS používá Face ID k odemknutí vaší karty."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LifeOS používá Face ID k odemknutí vaší karty."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "LifeOS potřebuje fotoaparát, abyste mohli vyfotit lékařskou zprávu nebo recept.",
          "photosPermission": "LifeOS potřebuje přístup k fotkám, abyste mohli připojit snímek k záznamu."
        }
      ],
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
